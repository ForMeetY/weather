<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.weathershow.mapper.WeatherKpiMetricsMapper">
<!-- 查询全部数据 -->

    <select id="queryAll" resultType="com.example.weathershow.pojo.WeatherKpiMetrics">
        select
        id,
        avg_all,
        high_threshold,
        low_threshold,
        avg_range_all,
        update_time
        from
        ads_weather_kpi_metrics
    </select>
</mapper>